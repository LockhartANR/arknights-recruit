# Dependencies
node_modules/

# Build output
dist/
# update.sh 做原子切换时的中间目录：先把新产物构建到 dist.new，再 mv 成 dist。
# 它们必须一并忽略 —— 否则某次在切换途中提交，就会把这批文件带进仓库，
# 之后每次构建都留下一堆「已删除」状态（实测被误提交过 450 个文件）。
dist.new/
dist.prev/

# Test artifacts
test-results/

# Environment secrets
.env

# Database files (auto-created on first run)
*.db
*.db-shm
*.db-wal

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Development process records
docs/

# ...but the operations docs ARE versioned: they are the deployment/runbook
# knowledge for this service and must travel with the repo.
# Negating the directory itself (not just its contents) is required, otherwise
# git never descends into docs/ and the rule below would have no effect.
!docs/
docs/*
!docs/ops/
