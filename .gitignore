# Dependencies
node_modules/

# Build output
dist/

# Test artifacts
test-results/

# Environment secrets
.env

# Database files (auto-created on first run)
*.db
*.db-shm
*.db-wal

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Development process records
docs/

# ...but the operations docs ARE versioned: they are the deployment/runbook
# knowledge for this service and must travel with the repo.
# Negating the directory itself (not just its contents) is required, otherwise
# git never descends into docs/ and the rule below would have no effect.
!docs/
docs/*
!docs/ops/
